#include<stdio.h>
#include<stdlib.h>
struct node
{
int data;
struct node *next;
};
struct node *F=NULL,*R=NULL;
void enqueue(int data)
{
struct node *p;
p=(struct node *)malloc(sizeof(struct node));
if(p==NULL)
printf("Allocation Error\n");
else
{
p->data=data;
p->next=NULL;
if(R==NULL)
{
R=p;
F=p;
}
else
{
R->next=p;
R=p;
}
}
}
void dequeue()
{
struct node *d;
if(R==NULL)
printf("underflow error");
else if(R==F)
{
printf("Deleted data= %d",F->data);
free(F);
F=NULL;
R=NULL;
} else
{
printf("Deleted data= %d",F->data);
d=F;
F=F->next;
free(d);
}
printf("\n");
}
void display()
{
struct node *t=F;
if(R==NULL)
printf("Circular Queue is empty");
else
{
while(t)
{
printf("%d ",t->data);
t=t->next;
}
}
printf("\n");
}
void IsEmpty()
{
if(R==NULL)
printf("Circular Queue is empty");
else
printf("Circular Queue is not empty");
printf("\n");
}
int main()
{
int op, data;
while(1) {
printf("1.Enqueue 2.Dequeue 3.Display 4.Is Empty 5.Exit\n");
printf("Enter your option : ");
scanf("%d",&op);
switch(op) {
case 1:
printf("Enter element : ");
scanf("%d",&data);
enqueue(data); break;
case 2:
dequeue();
break;
case 3:
display();
break;
case 4:
IsEmpty();
break;
case 5:
exit(0);
}
}
return 0;
}
