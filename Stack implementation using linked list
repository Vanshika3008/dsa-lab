#include <stdio.h>
#include <stdlib.h>
struct node{
    int data;
    struct node*next;
};
struct node *top=NULL;
void push(int item){
    struct node *new;
    new=(struct node*)malloc(sizeof(struct node));
    if(new==NULL)
        printf("Allocation Error");
    else{
        new->data = item;
        new->next = NULL;
        new->next = top;
        top=new;
    }
}
void pop(){
    struct node*d;
    if(top==NULL)
        printf("Stack is underflow.\n");
    else{
        d=top;
        top=top->next;
        printf("Deleted data is %d",d->data);
        free(d);
    }
}
void display(){
    struct node *t=top;
    if(top==NULL)
        printf("Stack is empty.\n");
    else{
        printf("Elements of the stack are : ");
        while(t!=NULL){
            printf("%d",t->data);
            t=t->next;
        }
        printf("\n");
    }
}
void isEmpty(){
    if(top==NULL)
        printf("Stack is empty.\n");
    else
        printf("Stack is not empty.\n");
    }
void peek(){
    if(top==NULL)
        printf("Stack is empty.\n");
    else
        printf("top value = %d\n",top->data);     
}
int main(){
    int op,data;
    while(1){
        printf("1.Push 2.Pop 3.Display 4. Is Empty 5.Peek 6.Exit\n");
        printf("Enter your option : ");
        scanf("%d",&op);
        switch(op){
            case 1:
            printf("Enter element : ");
            scanf("%d",&data);
            push(data);
            break;
            case 2:
            pop();
            case 3:
            display();
            break;
            case 4:
            isEmpty();
            break;
            case 5:
            peek();
            break;
            case 6:
            exit(0);
        }
    }
    return 0;
}
